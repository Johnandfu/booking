
upstream api-hyperf {
    # Hyperf HTTP Server 的 IP 及 端口
    server php:9501;
}
server {
    listen 80;
    server_name tss.jialenet.com;
    client_max_body_size 50M;
    # --- real IP 配置 ---
    real_ip_header X-Forwarded-For;
    set_real_ip_from 0.0.0.0/0; # 信任所有来源（可改成 Docker 内网网段，例如 172.16.0.0/12）

    # Certbot 验证目录
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # HTTP 跳转到 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS ---
server {
    listen 443 ssl;
    http2 on;
    server_name tss.jialenet.com;

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # 简化后的 SSL 设置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # 日志
    access_log /var/log/nginx/hyperf_access.log;
    error_log /var/log/nginx/hyperf_error.log;
    # --- real IP 配置 ---
    real_ip_header X-Forwarded-For;
    set_real_ip_from 0.0.0.0/0; # 信任所有来源（可改成 Docker 内网网段，例如 172.16.0.0/12）

    root /usr/share/nginx/html;
    index index.html;
    # 客户端配置
    client_max_body_size 128M;
    client_body_timeout 200s;
    client_header_timeout 200s;
    keepalive_timeout 200s;
    proxy_read_timeout 200s;
    send_timeout 200s;

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:2888;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    location /uploads/ {
        alias /mineadmin/storage/uploads/; # 示例路径，请根据实际部署环境调整
        expires 7d;
        add_header Cache-Control "public"; # 允许所有用户和中间缓存服务器（如CDN）缓存此资源，提高缓存效率
        add_header Access-Control-Allow-Origin https://example.com; # 只允许 https://example.com 域名的网页跨域请求本资源，提升安全性
    }

    # --- 代理到 Hyperf ---
    location ~ ^/(api|admin)/ {
        # --- CORS 设置 ---
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;

        # 预检请求快速返回
        if ($request_method = 'OPTIONS') {
            return 204;
        }
        proxy_pass http://api-hyperf;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~ /\.ht {
        deny all;
    }
}