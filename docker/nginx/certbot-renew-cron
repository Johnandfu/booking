#!/bin/sh

if [ "$ENABLE_SSL" != "true" ]; then
    echo "SSL disabled, skipping renewal."
    exit 0
fi

echo "Running monthly SSL renewal check..."
certbot renew --webroot -w /var/www/certbot --quiet --no-self-upgrade
if [ $? -eq 0 ]; then
    echo "SSL renewed successfully. Reloading nginx..."
    nginx -s reload
else
    echo "SSL renewal failed."
fi
